# HakiOS fragment: the Qualcomm SC8280XP family (SM8475 "Snapdragon 8cx Gen 3", "yupik"-class laptop SoC) -- what is true of
# the SoC, whatever device it is in.
# Addresses below are SC8280XP family facts taken from mainline Linux 7.3's arch/arm64/boot/dts/qcom/sc8280xp.dtsi and from
# right-0903/linux-gaokun's sc8280xp-huawei-gaokun3.dts. A device with this SoC gets these drivers whatever it leaves out of
# its own; device-specific differences (register offsets, pins, rails) go into the device's own fragment and soc.args.
#
# The processor has eight cores and the biggest is core 7; the temperature sensors, the chip-identity memory and the PMIC arbiter
# are at the addresses of this family (the kernel's defaults, which a port to another SoC overrides: soc_smem, thermal_tm0/1 ...).
# The sensors are read (CONFIG_THERMAL), and with them the run is handed back to the loader at 105 degrees, the driver's own default
# (the log says "thermal: ... stop at 105 C"); CONFIG_THERMAL_STOP=N in a device's fragment sets another limit, 0 none.

CONFIG_SOC="sc8280xp"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y

# the drivers of this SoC family: a device with it gets them from here, whatever phone-specific drivers it leaves out
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y

# SoC-level addresses, confirmed node by node against this device's own tree (see devices/gaokun3/soc.args):
# they all equal the kernel's SC7280-family defaults, so no soc_* argument is needed:
#   soc_ipcc 0x408000, soc_aoss 0xc300000, soc_rsc 0x18220000, soc_apps_smmu 0x15000000,
#   soc_smem 0x80900000, soc_cmd_db 0x80860000. The IPA/modem blocks (soc_ipa_base, soc_mpss_mem ...)
#   have no nodes on sc8280xp at all: its IPA is a different generation, the modem is a larger port.

# loader.c struct platform values for SC8280XP (filled into devices/gaokun3 and read by xnuloader/loader.c via platform_gaokun3):
#   gic_dist   : GICv3 distributor base          (intc@17a00000 in sc8280xp.dtsi)    -> 0x17A00000
#   gic_redist : GICv3 redistributor base        (redist cells of the same node)     -> 0x17A60000
#   uart       : none exposed (the machine has no serial console)                    -> 0 (log: framebuffer)
#   psci_hvc   : 0 = SMC (gaokun3 DT: arm,psci-1.0 method="smc")                   -> 0
#   cores      : 8; 0-3 Cortex-A78c (little), 4-7 Cortex-X1c (big)   -> 8, small_cores=0x0f
#   core_shift : MPIDR core bit field                                  -> 8 (like sc7280)
#   core_shift : MPIDR core bit field (aff1, as on SC7280)            -> 8
