# HakiOS fragment: the Huawei MateBook E Go 2023 (gaokun3, devices/gaokun3) -- what is true of this device and of no other
# with the same SoC.
# Addresses and numbers come from the device's own device tree (linux-gaokun: arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts,
# including sc8280xp.dtsi and sc8280xp-pmics.dtsi) and from mainline Linux 7.3's sc8280xp.dtsi. A port to another Qualcomm device
# turns them into soc.args instead.

CONFIG_DEVICE="gaokun3"
CONFIG_SOC="sc8280xp"

# SC8280XP: 8 cores, biggest is core 7 (the Cortex-X1c cluster). The kernel takes cores nearest to the boot core first.
# UEFI starts the loader on one core; the kernel takes the rest itself via PSCI CPU_ON (psci-method = "smc", see loader.c).
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
# SC8280XP is a two-cluster chip: EPSS blocks for the X1c and the A78c only. Reading where a
# third would be hangs the bus (the real machine stopped mid-cpufreq exactly there).
CONFIG_CPUFREQ_DOMAINS=2

# The chip's identity from the firmware's shared memory (SMEM item 137): kern.hakios.soc_*.
CONFIG_SOCINFO=y

# SC8280XP temperature sensors: LEFT OUT for now. The built-in driver reads the tsens-v2 status-word
# model at the SM7325 default (c263000); this SoC has qcom,tsens-v3 at other addresses, and on real
# hardware a read of a block that model does not describe hangs the on-chip bus (seen: the run stopped
# right after cpufreq, at thermal init). Not needed to boot; port the driver to v3, then re-enable.
# CONFIG_THERMAL is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_THERMAL_STOP=105

# The SPMI PMIC arbiter/clock: LEFT OUT for the same reason (read-only, same unmapped-hang risk on
# this SoC; not needed to boot). Re-enable when its addresses/model are confirmed here.
# CONFIG_PMIC is not set
# CONFIG_HAKIOS_PMIC is not set

# Every phone driver of the common repository is left out: their addresses, pins and rails are the POCO X5 Pro's,
# and a driver of another phone touching this machine is the last thing we want. Turn one on when it has been made
# to work here (see device.conf status lines).
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_UFS is not set
# The GPU of this machine -- Adreno A690 on SC8280XP -- runs the repository's own Adreno driver
# (drivers/gpu/hakios.adreno.c), which this build knows as this card (see its header). The island
# is the same addresses and layout the phone's is; the card's firmware (a660-line GMU and SQE, as
# Linux drives the A690, plus this SoC's signed shader named by the device tree) sits in ../fw-gpu
# and rides into the ramdisk at /fw. Bring-up is stepped and every step answers in the log.
CONFIG_GPU=y
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set

# Boot-arguments that this device passes on the command line (a device's fragment is also where its arguments live).
# soc.args (from tools/soc-args.py on the device's device tree) is appended by the runner automatically.
# The panel: the same one the loader now takes from this machine's device tree; user space is told its real size
# (without these the kernel keeps reporting the iPhone X panel it was built for and scales the picture).
CONFIG_BOOTARGS="fbwidth=1600 fbheight=2560"

# arguments whose drivers are not in this kernel go with them (docs/drivers-config.md: the check refuses
# an argument that only left-out drivers read)
# This machine's GPU firmware is on disk for it (../fw-gpu: the A690's GMU and SQE as Linux
# drives them, the a660 images, plus the SC8280XP shader signed as its device tree names it),
# so this configuration does take device firmware -- only what we have placed, never fetched.
CONFIG_FIRMWARE="device"

# CONFIG_UFS is not set
# The touch screen of this machine: the Himax HX83121a on QUPv3 SPI6, wired by its own device tree
# (pins 154-157 to the engine, 99 reset, 175 interrupt). The phone's Goodix driver stays out; the
# bus, pins and supplies of that one are not this laptop's.
CONFIG_TOUCHSCREEN=y
CONFIG_HAKIOS_HIMAX=y
